extends layout 

block content 
    h1 Order our Donuts here!
    p Please use your favorite ordering service below.

    .button-group 
        form(method='GET' action='/')
            label(for='home') Go to Home Page:
            button(type='submit')  Home
        form(method='GET' action='/menu')
            label(for='menu') View Menu:
            button(type='submit')  Menu
        form(method='GET' action='/about')
            label(for='about') About Us:
            button(type='submit') About
        form(method='GET' action='/comments')
            label(for='comments') View Comments:
            button(type='submit') Comments

    block doordash-logo
    a(href='https://www.doordash.com/' alt='General Link to DoorDash' style='padding-top: 20px;' class='order-link') 
        img(src='/images/Doordash.png', alt='DoorDash Logo', class='orderLogo') 
        br
        | Order on DoorDash
        //- br and text are on same indent as img, so they aren't nested in img
        //- | means that the text is considered as plain text, even though it's on separate line
        
    
    block ubereats-logo
    a(href='https://www.ubereats.com/store' alt='General Link to Uber Eats' style='padding-top: 20px;' class='order-link') 
        img(src='/images/UberEats.png', alt='Uber Eats Logo', class='orderLogo')
        br
        | Order on Uber Eats

    block grubhub-logo
    a(href='https://www.grubhub.com/' alt='General Link to Grubhub' style='padding-top: 20px;' class='order-link') 
        img(src='/images/grubHub.png', alt='Grubhub Logo', class='orderLogo')
        br
        | Order on Grubhub

    
extends layout 

block content
  h1 Menu
  
  .button-group
    form(method='GET' action='/')
      label(for='menu') Go to Home Page:
      button(type='submit')  Home
    form(method='GET' action='/about')
      label(for='about') About Us:
      button(type='submit') About
    form(method='GET' action='/order')
      label(for='order') Place an Order:
      button(type='submit') Order

  p View our delicious menu of donuts!
  img(src='/images/downtown_donuts_menu_front.png', alt='Downtown Donuts Menu - Signature Dontus', class='menu-image')
  img(src='/images/downtown_donuts_menu_back.png', alt='Downtown Donuts Menu - Drinks and More', class='menu-image')
    